{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@crypto-futures/shared": ["packages/shared/src/index.ts"],
      "@crypto-futures/analysis-core": ["packages/analysis-core/src/index.ts"],
      "@crypto-futures/shared/*": ["packages/shared/src/*"],
      "@crypto-futures/analysis-core/*": ["packages/analysis-core/src/*"]
    }
  }
}
