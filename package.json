{
  "name": "crypto-futures-ai-screener",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @crypto-futures/web",
    "dev:web": "npm run dev --workspace @crypto-futures/web",
    "dev:functions": "npm run dev --workspace @crypto-futures/functions",
    "live:worker": "npm run worker --workspace @crypto-futures/functions",
    "dev:live": "concurrently -k -n web,worker -c blue,green \"npm run dev:web\" \"npm run live:worker\"",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
